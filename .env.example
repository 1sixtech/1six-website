# Local builds need a token with Contents: read for 1sixtech/1six-researchs.
# Store the value in .env.local (ignored by git), never in this file.
WRITING_GITHUB_TOKEN=

# Vercel Production and Preview use the organization-owned GitHub App instead.
# All three settings are required when WRITING_GITHUB_TOKEN is not supplied.
WRITING_GITHUB_APP_ID=
WRITING_GITHUB_INSTALLATION_ID=
WRITING_GITHUB_PRIVATE_KEY=

# Keep main for automatic publication; pin a commit only to hold a release.
WRITING_GIT_REF=main
